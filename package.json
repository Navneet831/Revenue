{
    "name": "revenue-monorepo",
    "version": "1.0.0",
    "description": "Executive Revenue Analytics Platform",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "start": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000",
        "dev": "concurrently -n API,WEB -c cyan,magenta \"npm run dev:api\" \"npm run dev -w apps/web\"",
        "dev:api": "python -m uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000",
        "dev:web": "npm run dev -w apps/web",
        "build:shared": "npm run build -w packages/shared",
        "build:web": "npm run build -w apps/web",
        "build": "npm run build:shared && npm run build:web",
        "lint": "npm run lint --workspaces --if-present",
        "format": "prettier --write \"**/*.{js,ts,html,css,json}\" --ignore-path .gitignore",
        "test": "jest"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "autocannon": "^8.0.0",
        "concurrently": "^10.0.3",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^29.7.0",
        "prettier": "^3.8.3",
        "typescript": "^6.0.3"
    },
    "jest": {
        "roots": ["<rootDir>/maintenance/tests"],
        "testMatch": ["**/*.test.js"],
        "testPathIgnorePatterns": ["/node_modules/"]
    }
}
