                        <!-- WIDGET 3: CUSTOMERS -->
                        <div
                            id="w-cust"
                            data-cs="5"
                            data-ce="10"
                            data-rs="6"
                            data-re="13"
                            class="resizable-panel card-3d flex flex-col group relative rounded-2xl min-h-0 min-w-0 bg-[#111620] overflow-hidden"
                        >
                            <div
                                class="p-2 px-3 border-b border-slate-800 bg-[#0F1219] flex justify-between items-center z-50 shrink-0"
                            >
                                <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pr-2">
                                    <i
                                        data-lucide="users"
                                        class="w-4 h-4 text-[#0ea5e9] shrink-0 drop-shadow-[0_0_3px_rgba(14,165,233,0.6)]"
                                    ></i>
                                    <span
                                        class="text-[11px] font-bold text-white uppercase tracking-tight flex items-center whitespace-nowrap"
                                        >Clients
                                        <span id="cust-count" class="ml-1 text-slate-500 font-mono">(0)</span></span
                                    >
                                </div>
                                <div class="flex items-center gap-3 shrink-0">
                                    <span
                                        id="cust-metric-lbl"
                                        class="text-[9px] font-bold text-brand uppercase tracking-widest mr-2"
                                    ></span>
                                    <button
                                        id="cust-toggle-btn"
                                        onclick="UI.toggleCardView('cust')"
                                        class="p-1 px-2 btn-3d bg-[#1E293B] text-slate-300 hover:text-white rounded-md transition-colors"
                                        title="Toggle Table/Pipeline View"
                                        tabindex="0"
                                    >
                                        <i data-lucide="pie-chart" class="w-3.5 h-3.5 text-blue-400"></i>
                                    </button>
                                    <button
                                        onclick="UI.toggleExpand('w-cust')"
                                        class="p-1 px-2 btn-3d bg-[#1E293B] hover:bg-slate-700 text-white rounded-md hidden md:block"
                                        tabindex="0"
                                    >
                                        <i data-lucide="maximize" class="w-3.5 h-3.5"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="flex-1 w-full relative bg-transparent overflow-hidden">
                                <div
                                    id="cust-table-container"
                                    class="absolute inset-0 z-20 overflow-x-hidden overflow-y-auto no-scrollbar bg-transparent opacity-100 pointer-events-auto transition-opacity duration-300"
                                    data-lenis-prevent="true"
                                >
                                    <table class="w-full border-collapse min-w-full">
                                        <tbody id="cust-tbody"></tbody>
                                    </table>
                                </div>
                                <div
                                    id="cust-chart-container"
                                    class="absolute inset-0 z-10 flex flex-col overflow-y-auto no-scrollbar bg-[#090C10] opacity-0 pointer-events-none transition-opacity duration-300 relative"
                                    data-lenis-prevent="true"
                                >
                                    <div class="chart-noise-layer"></div>
                                    <div id="cust-chart-inner" class="relative w-full shrink-0 z-20 p-4">
                                        <canvas id="custChart"></canvas>
