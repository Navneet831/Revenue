            </svg>

            <!-- Mobile Backdrop for Sidebar -->
            <div
                id="mobile-sidebar-backdrop"
                class="fixed inset-0 bg-black/60 z-[99990] hidden lg:hidden transition-opacity"
                onclick="UI.toggleSidebar()"
            ></div>

            <!-- LEFT SIDEBAR: Navigation Rail -->
            <aside
                id="sidebar"
                class="fixed lg:relative inset-y-0 left-0 -translate-x-full lg:translate-x-0 w-64 lg:w-14 border-r border-dark-border bg-[#141b2d] transition-all duration-500 flex flex-col z-[99999] lg:z-50 shrink-0 shadow-2xl"
            >
                <div
                    class="w-full flex items-center shrink-0 border-b border-dark-border bg-[#0b101e] py-4 px-[13px] relative overflow-hidden group cursor-pointer"
                    onclick="UI.toggleSidebar()"
                    title="Toggle Sidebar"
                    data-shortcut="Ctrl+B"
                >
                    <div
                        class="w-7 h-7 shrink-0 flex items-center justify-center transition-all duration-500 group-hover:scale-110 group-hover:drop-shadow-[0_0_12px_rgba(16,185,129,0.6)]"
                    >
                        <svg
                            viewBox="0 0 100 100"
                            xmlns="http://www.w3.org/2000/svg"
                            preserveAspectRatio="xMidYMid meet"
                            class="w-full h-full"
                            style="shape-rendering: geometricPrecision"
                        >
                            <polygon points="4,17.5 88.5,17.5 47.5,95.5 42.5,47.5" fill="#17A38A" />
                            <polygon points="0,85.5 8,100 0,100" fill="#17A38A" />
                        </svg>
                    </div>
                    <div
                        id="sidebar-brand-text"
                        class="sidebar-text font-sans font-black text-white text-[11px] tracking-[0.25em] uppercase whitespace-nowrap transition-all duration-500"
                    >
                        Grew Solar<span class="text-brand">.</span>
                    </div>
                </div>

                <div
                    class="flex-1 overflow-y-auto overflow-x-hidden no-scrollbar bg-transparent"
                    id="sidebar-content"
                    data-lenis-prevent="true"
                >
                    <!-- Content injected by UI.renderSidebar() -->
                </div>

                <!-- Sidebar Footer: System Health & Help -->
                <div class="shrink-0 flex flex-col bg-[#0b101e] border-t border-dark-border">
                    <div class="p-3 w-full flex flex-col border-b border-dark-border/50">
                        <div class="flex items-center gap-2 mb-1 justify-center" id="health-header">
                            <i
                                data-lucide="activity"
                                class="w-4 h-4 text-emerald-500 cursor-pointer"
                                title="System Health"
                            ></i>
                        </div>
                        <div id="health-content">
                            <div
                                class="w-2 h-2 rounded-full bg-emerald-500 mx-auto animate-pulse-fast cursor-pointer"
                            ></div>
                        </div>
                    </div>
                    <div class="p-2 w-full flex justify-center items-center">
                        <button
                            onclick="UI.toggleHelp()"
                            class="sidebar-item group relative flex items-center cursor-pointer border border-transparent text-slate-500 hover:text-blue-400 transition-all p-2 rounded-xl hover:bg-slate-800/40 w-full"
                            tabindex="0"
                            data-shortcut="F1"
                        >
                            <i data-lucide="help-circle" class="w-5 h-5 shrink-0"></i>
                            <span
                                id="help-text"
                                class="sidebar-text text-[11px] font-bold uppercase tracking-wider text-slate-400 group-hover:text-blue-400 whitespace-nowrap transition-all duration-300"
                                >System Manual</span
                            >

                            <div
                                class="sidebar-tooltip absolute left-full ml-4 px-3 py-1.5 bg-[#0b101e]/60 border border-dark-border rounded-2xl text-[10px] text-white font-bold whitespace-nowrap opacity-0 group-hover:opacity-100 pointer-events-none transition-all duration-300 translate-x-[-10px] group-hover:translate-x-0 z-[100] shadow-2xl backdrop-blur-md"
                            >
                                <div class="flex items-center gap-2">
                                    <i data-lucide="help-circle" class="w-3 h-3 text-blue-400"></i>
                                    System Manual (F1)
                                </div>
                            </div>
                        </button>
                    </div>
                </div>
            </aside>

            <main class="flex-1 flex flex-col h-full relative overflow-hidden min-w-0">
                <!-- GLOBAL STATE HEADER -->
                <header
                    class="bg-[#0F1219] border-b border-slate-800 flex flex-col lg:flex-row justify-between items-start lg:items-center px-4 py-2 shrink-0 z-40 relative gap-3 min-w-0 w-full max-w-full overflow-hidden"
                >
                    <div
                        class="flex items-center gap-3 overflow-x-auto flex-1 min-w-0 no-scrollbar pb-1 lg:pb-0 w-full"
                    >
                        <button
                            onclick="UI.toggleSidebar()"
                            class="lg:hidden p-1.5 hover:bg-slate-800 border border-slate-700 text-slate-300 rounded-md shrink-0 btn-3d bg-[#111620]"
                        >
                            <i data-lucide="menu" class="w-4 h-4"></i>
                        </button>

                        <!-- TOP-LEFT: Financial Year Absolute Anchors -->
                        <div
                            class="flex items-center shrink-0 border-r border-slate-700 pr-3 gap-1"
                            id="global-fy-shortcuts"
                        >
                            <!-- Injected FY Tabs -->
                        </div>

                        <div class="flex items-center gap-2 shrink-0" id="global-filters-container">
                            <!-- CHRONOLOGICAL FILTERS FIRST -->
                            <div
                                class="flex items-center bg-[#111620] rounded-md overflow-hidden btn-3d"
                                title="From Date (Isolates primary KPI)"
                            >
                                <div class="relative">
                                    <input
                                        type="text"
                                        id="dt-start"
                                        class="w-[90px] bg-transparent text-slate-400 focus:text-white text-[10px] p-1.5 pl-6 outline-none font-mono tracking-tight cursor-pointer hover:bg-slate-800 transition-colors"
                                        placeholder="From Date"
                                    />
                                    <i
                                        data-lucide="calendar"
                                        class="w-3 h-3 text-slate-500 absolute left-2 top-2 pointer-events-none"
                                    ></i>
                                </div>
                                <button
                                    onclick="UI.clearStartDate()"
                                    class="pr-2 pl-1 text-slate-600 hover:text-rose-400 transition-colors focus:outline-none"
                                    title="Clear Period Filter"
                                >
                                    <i data-lucide="x" class="w-3 h-3"></i>
                                </button>
                            </div>
                            <span class="text-slate-600 text-xs font-bold px-0.5 shrink-0">-</span>
                            <div
                                class="flex items-center bg-[#111620] rounded-md overflow-hidden btn-3d"
                                title="As Of Date (System Anchor)"
                                data-shortcut="Date + ← / →"
                            >
                                <div class="relative">
                                    <input
                                        type="text"
                                        id="dt-end"
                                        class="w-24 bg-transparent text-white text-[10px] p-1.5 pl-6 outline-none font-mono tracking-tight cursor-pointer hover:bg-slate-800 transition-colors"
                                        placeholder="To Date"
                                        tabindex="0"
                                    />
                                    <i
                                        data-lucide="calendar"
                                        class="w-3 h-3 text-brand absolute left-2 top-2 pointer-events-none"
                                    ></i>
                                </div>
                            </div>

                            <button
                                onclick="UI.resetDateRange()"
                                class="p-1.5 hover:bg-slate-700 text-slate-400 hover:text-white rounded-md transition-colors bg-[#151921] btn-3d shrink-0 ml-1"
                                title="Reset Timeline to Latest Data"
                                tabindex="0"
                            >
                                <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
                            </button>

                            <div class="w-px h-4 bg-slate-700 shrink-0 mx-2"></div>

                            <!-- TOP-LEVEL SEGMENT FILTER MOVED AFTER DATE -->
                            <div id="segment-dropdown-container" class="relative shrink-0 z-[100] mr-1"></div>
                        </div>

                        <div class="hidden lg:block w-px h-4 bg-slate-700 shrink-0 mx-2"></div>

                        <!-- Breadcrumbs -->
                        <div
                            class="flex items-center gap-2 overflow-x-auto no-scrollbar shrink-0"
                            id="global-breadcrumbs"
                        >
                            <!-- Injected Breadcrumbs -->
                        </div>
                    </div>

                    <div
                        class="flex items-center gap-3 overflow-x-auto shrink-0 no-scrollbar justify-between pb-1 lg:pb-0"
                    >
                        <!-- Metric Toggles (Pill Design) -->
                        <div class="flex shrink-0" id="global-metric-toggle"></div>

                        <div class="w-px h-6 bg-slate-700 shrink-0"></div>

                        <button
                            onclick="UI.toggleInsightsPanel()"
                            class="flex items-center justify-center text-[#FFC000] hover:scale-110 transition-transform drop-shadow-[0_0_8px_rgba(255,192,0,0.5)] hover:drop-shadow-[0_0_15px_rgba(255,192,0,0.9)] shrink-0 outline-none pr-1"
                            title="Toggle Intelligence Board (Ctrl+I)"
                            tabindex="0"
                            data-shortcut="Ctrl+I"
                        >
                            <div class="w-5 h-5" id="header-insight-icon"></div>
                        </button>

                        <!-- User Profile & Logout -->
                        <div class="w-px h-6 bg-slate-700 shrink-0 mx-1 border-r border-slate-800"></div>
                        <div
                            id="user-avatar"
                            class="w-7 h-7 rounded-full bg-slate-800 hover:bg-slate-700 border border-slate-700 flex items-center justify-center text-brand font-black text-[10px] uppercase transition-colors shadow-inner cursor-pointer shrink-0"
                            title="Active Session"
                        >
                            --
                        </div>
                        <button
                            onclick="AuthEngine.signOut()"
                            class="flex items-center justify-center text-slate-500 hover:text-red-400 transition-colors p-1 rounded-md shrink-0"
                            title="Secure Logout"
                        >
                            <i data-lucide="log-out" class="w-4 h-4"></i>
                        </button>
                    </div>
                </header>

                <!-- Fluid KPI Row -->
                <div class="p-3 bg-[#090C10] shrink-0 w-full border-b border-slate-800 z-30 relative min-w-0">
                    <div
                        class="flex w-full gap-3 pb-4 overflow-x-auto no-scrollbar"
                        id="kpi-container"
                        data-lenis-prevent="true"
                    >
                        <!-- Injected KPIs -->
                    </div>
                </div>

                <!-- EXPLICIT 12x12 GRID ARCHITECTURE: Locked 1-8 and 8-13 Vertical Splits -->
                <div
                    class="flex-1 relative min-w-0 overflow-y-auto overflow-x-hidden no-scrollbar"
                    id="dashboard-wrapper"
                >
                    <div
                        id="dashboard-canvas"
                        class="px-3 pb-3 pt-3 lg:grid lg:grid-cols-12 lg:grid-rows-12 gap-4 h-full min-h-[700px]"
                    >
                        <!-- WIDGET 1: MASTER ENGINE (Spans 1 to 6) -->
                        <div
                            id="w-master"
                            data-cs="1"
                            data-ce="13"
                            data-rs="1"
                            data-re="6"
                            class="resizable-panel card-3d flex flex-col group relative rounded-2xl min-h-0 min-w-0 bg-[#111620] overflow-hidden"
                        >
                            <div
                                class="p-1 px-3 border-b border-slate-800 bg-[#0F1219] flex justify-between items-center z-50 shrink-0 h-9"
                            >
                                <div class="flex items-center gap-2 overflow-hidden flex-1">
                                    <div class="flex items-center shrink-0">
                                        <i data-lucide="layout-dashboard" class="w-3.5 h-3.5 text-brand mr-2"></i>
                                        <span
                                            id="master-title"
                                            class="text-[10px] font-bold text-white uppercase tracking-tight flex items-center whitespace-nowrap"
                                            >Revenue Matrix & Velocity</span
                                        >
                                    </div>
                                    <div
                                        id="velocity-legend-wrapper"
                                        class="flex-1 ml-4 hidden md:flex items-center no-scrollbar"
                                    >
                                        <div
                                            id="velocity-legend"
                                            class="flex items-center gap-x-3 w-full justify-start overflow-x-auto no-scrollbar"
                                        ></div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3 shrink-0 ml-2">
                                    <div
                                        id="velocity-controls"
                                        class="flex gap-2 items-center transition-opacity duration-300 opacity-0 pointer-events-none"
                                    ></div>

                                    <button
                                        id="master-toggle-btn"
                                        onclick="UI.toggleCardView('master')"
                                        class="p-1 px-2 btn-3d bg-[#1E293B] text-slate-300 hover:text-white rounded-md transition-colors"
                                        title="Toggle Matrix/Velocity View"
                                        tabindex="0"
                                    >
                                        <i data-lucide="pie-chart" class="w-3.5 h-3.5 text-blue-400"></i>
                                    </button>

                                    <button
                                        onclick="UI.resetChartZoom()"
                                        class="p-1 px-2 btn-3d bg-[#1E293B] hover:bg-slate-700 text-white rounded-md hidden"
                                        id="btn-zoom-reset"
                                        title="Reset Zoom"
                                        tabindex="0"
                                    >
                                        <i data-lucide="rotate-ccw" class="w-3.5 h-3.5 text-brand"></i>
                                    </button>
                                    <button
                                        onclick="UI.toggleExpand('w-master')"
                                        class="p-1 px-2 btn-3d bg-[#1E293B] hover:bg-slate-700 text-white rounded-md hidden md:block"
                                        tabindex="0"
                                    >
                                        <i data-lucide="maximize" class="w-3.5 h-3.5"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="flex-1 w-full relative bg-transparent overflow-hidden flex flex-col min-h-0">
                                <!-- Persistent Matrix Header: Always visible -->
                                <div
                                    id="matrix-header-container"
                                    class="w-full shrink-0 z-30 bg-[#141b2d]/95 backdrop-blur border-b border-dark-border"
                                >
                                    <table class="w-full border-collapse" style="table-layout: fixed; min-width: 100%">
                                        <thead id="matrix-thead">
                                            <!-- Injected via JS -->
                                        </thead>
                                    </table>
                                </div>

                                <div class="flex-1 w-full relative bg-transparent overflow-hidden">
                                    <div
                                        id="matrix-container"
                                        class="absolute inset-0 z-20 overflow-y-auto no-scrollbar bg-transparent transition-opacity duration-300 opacity-100 pointer-events-auto"
                                        data-lenis-prevent="true"
                                    >
                                        <table class="w-full border-collapse min-w-full" style="table-layout: fixed">
                                            <tbody id="matrix-tbody">
                                                <!-- Injected via JS -->
                                            </tbody>
                                        </table>
                                    </div>
                                    <div
                                        id="velocity-container"
                                        class="absolute inset-0 z-10 opacity-0 pointer-events-none transition-opacity duration-300 bg-[#0b101e] flex flex-col"
                                    >
                                        <div class="chart-noise-layer"></div>
                                        <div class="relative z-20 w-full flex-1 px-2 pb-2 pt-4">
                                            <!-- Increased pt to clear custom space -->
                                            <canvas id="mainChart"></canvas>
                                        </div>
                                    </div>
                                </div>
