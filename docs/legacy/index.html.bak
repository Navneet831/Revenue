                        <!-- WIDGET 4: SKU -->
                        <div
                            id="w-sku"
                            data-cs="10"
                            data-ce="13"
                            data-rs="6"
                            data-re="13"
                            class="resizable-panel card-3d flex flex-col group relative rounded-2xl min-h-0 min-w-0 bg-[#111620] overflow-hidden"
                        >
                            <div
                                class="p-2 px-3 border-b border-slate-800 bg-[#0F1219] flex justify-between items-center z-50 shrink-0"
                            >
                                <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pr-2">
                                    <i
                                        data-lucide="box"
                                        class="w-4 h-4 text-[#8b5cf6] shrink-0 drop-shadow-[0_0_3px_rgba(139,92,246,0.6)]"
                                    ></i>
                                    <span
                                        class="text-[11px] font-bold text-white uppercase tracking-tight flex items-center whitespace-nowrap"
                                        >SKUs
                                        <span id="sku-count" class="ml-1 text-slate-500 font-mono">(0)</span></span
                                    >
                                </div>
                                <div class="flex items-center gap-3 shrink-0">
                                    <span
                                        id="sku-metric-lbl"
                                        class="text-[9px] font-bold text-brand uppercase tracking-widest mr-2"
                                    ></span>
                                    <button
                                        id="sku-toggle-btn"
                                        onclick="UI.toggleCardView('sku')"
                                        class="p-1 px-2 btn-3d bg-[#1E293B] text-slate-300 hover:text-white rounded-md transition-colors"
                                        title="Toggle Table/Chart View"
                                        tabindex="0"
                                    >
                                        <i data-lucide="pie-chart" class="w-3.5 h-3.5 text-blue-400"></i>
                                    </button>
                                    <button
                                        onclick="UI.toggleExpand('w-sku')"
                                        class="p-1 px-2 btn-3d bg-[#1E293B] hover:bg-slate-700 text-white rounded-md hidden md:block"
                                        tabindex="0"
                                    >
                                        <i data-lucide="maximize" class="w-3.5 h-3.5"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="flex-1 w-full relative bg-transparent overflow-hidden">
                                <div
                                    id="sku-table-container"
                                    class="absolute inset-0 z-20 overflow-x-hidden overflow-y-auto no-scrollbar bg-transparent opacity-100 pointer-events-auto transition-opacity duration-300"
                                    data-lenis-prevent="true"
                                >
                                    <table class="w-full border-collapse min-w-full">
                                        <tbody id="sku-tbody"></tbody>
                                    </table>
                                </div>
                                <div
                                    id="sku-chart-container"
                                    class="absolute inset-0 z-10 flex flex-col overflow-y-auto no-scrollbar bg-[#090C10] opacity-0 pointer-events-none transition-opacity duration-300 relative"
                                    data-lenis-prevent="true"
                                >
                                    <div class="chart-noise-layer"></div>
                                    <div id="sku-chart-inner" class="relative w-full shrink-0 z-20 p-4">
                                        <canvas id="skuChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <footer
                    class="shrink-0 border-t border-dark-border bg-[#0b101e] py-2 px-5 flex justify-between items-center text-xs font-semibold tracking-wide text-slate-500 z-20 relative"
                >
                    <span id="last-updated-date">Last updated on --</span>
                    <span
                        class="cursor-pointer hover:text-white transition-colors"
                        onclick="UI.toggleAuthor(this)"
                        tabindex="0"
                        >© Grew Energy Private Limited</span
                    >
                </footer>
            </main>
        </div>

        <!-- MAIN APP SCRIPT -->
        <script>
            const SUPABASE_URL = 'https://zqbciwvyxgjoprsetbgw.supabase.co';
            const SUPABASE_ANON_KEY =
                'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpxYmNpd3Z5eGdqb3Byc2V0Ymd3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzA0MjkzMzUsImV4cCI6MjA4NjAwNTMzNX0.d3CjohQaSpf58DdRyI2zwMr2MuCEHXpN9diy5q6RztY';
            const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

            // --- VISUAL ENGINE (Auth Matrix) ---
            function startVisuals() {
                const canvas = document.getElementById('space-canvas');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                let mouse = { x: 0, y: 0 };
                window.addEventListener(
                    'mousemove',
                    (e) =>
                        (mouse = {
                            x: (e.clientX - window.innerWidth / 2) / 50,
                            y: (e.clientY - window.innerHeight / 2) / 50
                        })
                );
                const res = () => {
                    canvas.width = window.innerWidth;
                    canvas.height = window.innerHeight;
                };
                window.addEventListener('resize', res);
                res();
                const stars = Array.from({ length: 150 }).map(() => ({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    size: Math.random() * 1.5,
                    alpha: Math.random(),
                    fs: Math.random() * 0.02 + 0.005
                }));
                function anim() {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    stars.forEach((s) => {
                        const x = (s.x + mouse.x * s.size) % canvas.width;
                        const y = (s.y + mouse.y * s.size) % canvas.height;
                        s.alpha += s.fs;
                        if (s.alpha > 1 || s.alpha < 0) s.fs *= -1;
                        ctx.beginPath();
                        ctx.arc(x < 0 ? x + canvas.width : x, y < 0 ? y + canvas.height : y, s.size, 0, Math.PI * 2);
                        ctx.fillStyle = `rgba(255, 255, 255, ${Math.max(0, Math.min(1, s.alpha))})`;
                        ctx.fill();
                    });
                    requestAnimationFrame(anim);
                }
                anim();

                const words = ['Solar', 'Energy', 'Analytics'];
                const el = document.getElementById('typewriter');
                let idx = 0,
                    sub = 0,
                    rev = false;
                function type() {
                    if (!el) return;
                    const cur = words[idx];
                    if (sub === cur.length + 1 && !rev) {
                        rev = true;
                        setTimeout(type, 1500);
                        return;
                    }
                    if (sub === 0 && rev) {
                        rev = false;
                        idx = (idx + 1) % words.length;
                        setTimeout(type, 500);
                        return;
                    }
                    sub += rev ? -1 : 1;
                    el.innerText = cur.substring(0, sub);
                    setTimeout(type, Math.max(rev ? 75 : 120, parseInt(Math.random() * 50)));
                }
                type();

                const cont = document.getElementById('auth-ui');
                const wrap = document.getElementById('wobble-wrapper');
                const card = document.getElementById('glass-card');
                if (cont && wrap && card) {
                    cont.addEventListener('mousemove', (e) => {
                        const r = cont.getBoundingClientRect();
                        const rX = ((e.clientY - r.top - r.height / 2) / (r.height / 2)) * 10;
                        const rY = ((e.clientX - r.left - r.width / 2) / (r.width / 2)) * -10;
                        wrap.style.transform = `rotateX(${rX}deg) rotateY(${rY}deg)`;
                        const cR = card.getBoundingClientRect();
                        card.style.setProperty('--x', `${e.clientX - cR.left}px`);
                        card.style.setProperty('--y', `${e.clientY - cR.top}px`);
                    });
                    cont.addEventListener('mouseleave', () => (wrap.style.transform = `rotateX(0deg) rotateY(0deg)`));
                }
            }

            // --- SECURE AUTH ENGINE ---
            const AuthEngine = {
                state: { currentEmail: null, isOtpMode: false },
                init: async () => {
                    try {
                        startVisuals();
                        AuthEngine.setupOTPInputs();

                        const queryParams = new URLSearchParams(window.location.search);
                        const bypass = queryParams.get('bypass_auth') === 'true';
                        if (bypass) {
                            console.log('[Auth] Bypassing auth credentials for development/testing.');
                            STATE.userEmail = 'tester@grew.power';
                            const layer = document.getElementById('auth-layer');
                            layer.classList.add('fade-out-matrix');
                            setTimeout(() => {
                                layer.classList.add('hidden');
                                const os = document.getElementById('core-app');
                                os.classList.remove('hidden');
                                os.classList.add('flex');
                                setTimeout(() => (os.style.opacity = '1'), 100);
                                GridResizer.init();
                                const loader = document.getElementById('global-loader');
                                if (loader) {
                                    loader.classList.remove('hidden');
                                    loader.classList.add('flex');
                                }
                                bootEngine();
                            }, 800);
                            return;
                        }

                        if (typeof supabase === 'undefined') {
                            throw new Error('Supabase library failed to load. Please check your internet connection.');
                        }

                        // Proactive session retrieval with timeout
                        const sessionPromise = supabaseClient.auth.getSession();
                        const timeoutPromise = new Promise((_, reject) =>
                            setTimeout(
                                () => reject(new Error('Connection Timeout: Supabase is taking too long to respond.')),
                                15000
                            )
                        );

                        const {
                            data: { session }
                        } = await Promise.race([sessionPromise, timeoutPromise]);

                        if (session) {
                            await AuthEngine.verifyWhitelist(session);
                        } else {
                            AuthEngine.showUI();
                        }

                        supabaseClient.auth.onAuthStateChange(async (event, newSession) => {
                            if (newSession && (event === 'SIGNED_IN' || event === 'INITIAL_SESSION')) {
                                AuthEngine.hideUI();
                                setTimeout(() => AuthEngine.verifyWhitelist(newSession), 500);
                            } else if (event === 'SIGNED_OUT') {
                                AuthEngine.showUI();
                                AuthEngine.resetForm();
                            }
                        });
                    } catch (err) {
                        console.error('[AUTH ENGINE] Init Failure:', err);
                        document.getElementById('auth-loading').classList.add('hidden');
                        AuthEngine.notify(err.message || 'Critical Boot Error. Check Matrix Connection.', 'error');
                        AuthEngine.showUI();
                    }
                },
                setupOTPInputs: () => {
                    const inputs = document.querySelectorAll('.otp-digit');
                    inputs.forEach((input, index) => {
                        input.addEventListener('input', (e) => {
                            if (input.value.length > 1) {
                                const val = input.value.slice(0, 8).replace(/\D/g, '');
                                inputs.forEach((inp, i) => (inp.value = val[i] || ''));
                                const focusIndex = Math.min(val.length, 7);
                                inputs[focusIndex].focus();
                                if (val.length === 8)
                                    setTimeout(() => document.getElementById('btn-submit').click(), 100);
                                return;
                            }
                            if (input.value !== '' && index < 7) inputs[index + 1].focus();
                            if (index === 7 && input.value !== '')
                                setTimeout(() => document.getElementById('btn-submit').click(), 150);
                        });
                        input.addEventListener('keydown', (e) => {
                            if (e.key === 'Backspace' && input.value === '' && index > 0) inputs[index - 1].focus();
                        });
                    });
                },

                getOTPValue: () => {
                    const inputs = document.querySelectorAll('.otp-digit');
                    let otp = '';
                    inputs.forEach((inp) => (otp += inp.value));
                    return otp;
                },

                verifyWhitelist: async (session) => {
                    const email = session?.user?.email?.trim().toLowerCase();
                    if (!email) return;

                    try {
                        const { data, error } = await supabaseClient
                            .from('whitelist')
                            .select('email')
                            .eq('email', email)
                            .maybeSingle();

                        if (error) throw error;

                        if (!data) {
                            await supabaseClient.auth.signOut();
                            AuthEngine.notify(`ACCESS DENIED. Your email (${email}) is not authorized.`, 'error');
                            AuthEngine.showUI();
                            AuthEngine.resetForm();
                        } else {
                            STATE.userEmail = email;
                            const avatar = document.getElementById('user-avatar');
                            if (avatar) {
                                const splitEmail = email.split('@')[0];
                                avatar.innerText = splitEmail.substring(0, 2).toUpperCase();
                                avatar.title = email.toUpperCase();
                            }

                            const layer = document.getElementById('auth-layer');
                            layer.classList.add('fade-out-matrix');

                            setTimeout(() => {
                                layer.classList.add('hidden');
                                const os = document.getElementById('core-app');
                                os.classList.remove('hidden');
                                os.classList.add('flex');
                                setTimeout(() => (os.style.opacity = '1'), 100);

                                GridResizer.init();

                                const loader = document.getElementById('global-loader');
                                if (loader) {
                                    loader.classList.remove('hidden');
                                    loader.classList.add('flex');
                                }
                                bootEngine();
                            }, 800);
                        }
                    } catch (err) {
                        console.error('[AUTH ENGINE] Fatal exception in verifyWhitelist:', err);
                        AuthEngine.notify('Matrix Connection Error. Check Console for DB Policy issues.', 'error');
                        AuthEngine.showUI();
                    }
                },

                handleFormSubmit: async (e) => {
                    e.preventDefault();
                    if (AuthEngine.state.isOtpMode) await AuthEngine.submitOTP();
                    else await AuthEngine.requestOTP();
                },

                requestOTP: async () => {
                    const email = document.getElementById('email-input').value.trim().toLowerCase();
                    const btn = document.getElementById('btn-submit');
                    AuthEngine.clearNotification();
                    btn.innerHTML = '<div class="auth-loader w-4 h-4 border-[2px]"></div>';
                    btn.disabled = true;

                    try {
                        const { data: whitelistData, error: whitelistError } = await supabaseClient
                            .from('whitelist')
                            .select('email')
                            .eq('email', email)
                            .maybeSingle();

                        if (whitelistError) throw whitelistError;

                        if (!whitelistData) {
                            AuthEngine.notify(`ACCESS DENIED. ${email} is not in the executive whitelist.`, 'error');
                            btn.innerHTML = 'Verify Email Access';
                            btn.disabled = false;
                            return;
                        }

                        const { error } = await supabaseClient.auth.signInWithOtp({
                            email,
                            options: { emailRedirectTo: window.location.origin }
                        });

                        if (error) throw error;

                        AuthEngine.state.currentEmail = email;
                        AuthEngine.state.isOtpMode = true;

                        document.getElementById('step-email').classList.add('hidden');
                        document.getElementById('btn-google').classList.add('hidden');
                        document.getElementById('oauth-divider').classList.add('hidden');

                        const otpStep = document.getElementById('step-otp');
                        otpStep.classList.remove('hidden');
                        otpStep.classList.add('flex');

                        setTimeout(() => document.querySelectorAll('.otp-digit')[0].focus(), 100);

                        btn.innerText = 'Verify Authorization Array';
                        btn.disabled = false;
                        AuthEngine.notify(`Security code dispatched to ${email}`, 'success');
                    } catch (err) {
                        let errorMessage = err.message || 'System Error: Unable to dispatch code.';
                        if (errorMessage.toLowerCase().includes('rate limit')) {
                            AuthEngine.notify(
                                'SUPABASE LIMIT: Free tier email rate limit exceeded (3 per hour). Wait or upgrade auth.',
                                'error'
                            );
                            let cooldown = 60;
                            btn.disabled = true;
                            const timer = setInterval(() => {
                                cooldown--;
                                btn.innerHTML = `Locked: ${cooldown}s`;
                                if (cooldown <= 0) {
                                    clearInterval(timer);
                                    btn.innerHTML = 'Verify Email Access';
                                    btn.disabled = false;
                                }
                            }, 1000);
                            return;
                        }
                        AuthEngine.notify(`Failed: ${errorMessage}`, 'error');
                        btn.innerHTML = 'Verify Email Access';
                        btn.disabled = false;
                    }
                },

                submitOTP: async () => {
                    const otp = AuthEngine.getOTPValue();
                    const btn = document.getElementById('btn-submit');

                    if (otp.length !== 8) {
                        AuthEngine.notify('Incomplete array. Expecting 8 digits.', 'error');
                        return;
                    }

                    AuthEngine.clearNotification();
                    btn.innerHTML = '<div class="auth-loader w-4 h-4 border-[2px]"></div>';
                    btn.disabled = true;

                    try {
                        const { data, error } = await supabaseClient.auth.verifyOtp({
                            email: AuthEngine.state.currentEmail,
                            token: otp,
                            type: 'email'
                        });

                        if (error) throw error;
                        btn.innerText = 'Authenticating...';
                    } catch (err) {
                        AuthEngine.notify('Code rejected or expired.', 'error');
                        btn.innerText = 'Verify Authorization Array';
                        btn.disabled = false;

                        const inputs = document.querySelectorAll('.otp-digit');
                        inputs.forEach((inp) => (inp.value = ''));
                        inputs[0].focus();
                    }
                },

                handleGoogleLogin: async () => {
                    AuthEngine.clearNotification();
                    const currentDomain = window.location.origin;
                    const { error } = await supabaseClient.auth.signInWithOAuth({
                        provider: 'google',
                        options: {
                            redirectTo: currentDomain,
                            queryParams: { prompt: 'select_account' }
                        }
                    });
                    if (error) AuthEngine.notify(error.message, 'error');
                },

                signOut: async () => {
                    await supabaseClient.auth.signOut();
                    window.location.reload();
                },

                resetForm: () => {
                    AuthEngine.state.isOtpMode = false;
                    AuthEngine.state.currentEmail = null;
                    document.getElementById('auth-form').reset();

                    document.getElementById('step-otp').classList.add('hidden');
                    document.getElementById('step-otp').classList.remove('flex');
                    document.getElementById('step-email').classList.remove('hidden');
                    document.getElementById('btn-google').classList.remove('hidden');
                    document.getElementById('oauth-divider').classList.remove('hidden');

                    document.getElementById('btn-submit').innerText = 'Verify Email Access';
                    document.getElementById('btn-submit').disabled = false;
                    document.querySelectorAll('.otp-digit').forEach((inp) => (inp.value = ''));
                },

                showUI: () => {
                    const layer = document.getElementById('auth-layer');
                    layer.classList.remove('hidden', 'fade-out-matrix');
                    layer.style.opacity = '1';
                    layer.style.transform = 'none';
                    layer.style.pointerEvents = 'auto';

                    document.getElementById('core-app').classList.add('hidden');
                    document.getElementById('auth-loading').classList.add('hidden');
                    document.getElementById('auth-ui').classList.remove('hidden');
                    if (window.lucide) lucide.createIcons();
                },

                hideUI: () => {
                    document.getElementById('auth-loading').classList.remove('hidden');
                    document.getElementById('auth-ui').classList.add('hidden');
                },

                notify: (msg, type = 'error') => {
                    const box = document.getElementById('auth-notification');
                    const icon = document.getElementById('notification-icon');
                    const text = document.getElementById('notification-msg');

                    box.className = `border p-4 rounded-xl mt-4 flex items-start gap-3 animate-in fade-in slide-in-from-top-2 ${
                        type === 'error' ? 'bg-red-500/10 border-red-500/20' : 'bg-brand/10 border-brand/20'
                    }`;
                    icon.setAttribute('data-lucide', type === 'error' ? 'shield-alert' : 'check-circle');
                    icon.className = `w-5 h-5 shrink-0 mt-0.5 ${type === 'error' ? 'text-red-500' : 'text-brand'}`;
                    text.className = `text-[10px] font-bold tracking-wide uppercase leading-relaxed ${type === 'error' ? 'text-red-400' : 'text-brand'}`;
                    text.innerText = msg;
                    box.classList.remove('hidden');
                    if (window.lucide) lucide.createIcons();
                },

                clearNotification: () => {
                    document.getElementById('auth-notification').classList.add('hidden');
                }
            };

            const lenis = new Lenis({
                wrapper: document.getElementById('dashboard-wrapper'),
                content: document.getElementById('dashboard-canvas'),
                duration: 1.2,
                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                smooth: true
            });
            function raf(time) {
                lenis.raf(time);
                requestAnimationFrame(raf);
            }
            requestAnimationFrame(raf);

            const CONFIG = {
                SHEET_ID: null,
                SHEET_NAME: 'revenue',
                CURRENCY_DIVIDER: 10000000,
                FISCAL_MONTHS: ['Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar'],
                CALENDAR_MONTHS: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                FULL_MONTHS: [
                    'January',
                    'February',
                    'March',
                    'April',
                    'May',
                    'June',
                    'July',
                    'August',
                    'September',
