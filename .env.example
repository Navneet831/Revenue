# Supabase Configuration (used by frontend and Node backend)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Server Port
PORT=8000
HOST=0.0.0.0

# NOTE: Database credentials are NOT stored locally.
# They are configured as Supabase project secrets (Settings → Edge Functions → Secrets):
#   PG_HOST, PG_PORT, PG_USER, PG_PASSWORD, PG_DATABASE
# Set them via: supabase secrets set PG_HOST=<value>
